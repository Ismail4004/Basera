# Copy this file to .env and fill in real values. Never commit .env.

# Django (both optional for local development; settings.py has local fallbacks)
# Generate a secret key with:
#   .venv/Scripts/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
# On a live site set DEBUG=False; SECRET_KEY then must be set, and so must
# ALLOWED_HOSTS (comma-separated, for example basera.onrender.com). Render does
# all of this for you through render.yaml: see docs/deployment/README.md.
ALLOWED_HOSTS=

# PostgreSQL (see docs/database/README.md). Hosts give a single DATABASE_URL
# instead; when it is set the DB_* lines below are ignored.
# DATABASE_URL=postgres://user:password@host:5432/name
DB_NAME=basera
DB_USER=basera_app
# The password you typed when docs/database/setup_postgres.sql asked for it.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (optional). Fill both to send real emails through Gmail; leave them
# empty to print emails in the runserver console instead.
# EMAIL_APP_PASSWORD is a Gmail "app password" (16 characters), not the
# Gmail account password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Live-site extras (all optional locally; render.yaml sets them on Render)
# SERVE_MEDIA=True            serve the plant photos from Django
# SEED_DEMO_ACCOUNTS=False    seed_catalog makes no demo logins (use on a public site)
# ADMIN_EMAIL=                seed_catalog creates this admin if it does not exist
# ADMIN_PASSWORD=             (must pass the password rules)
# SECURE_SSL_REDIRECT=False   only to test a DEBUG=False build over plain http
