# Copy this file to .env and fill in real values. Never commit .env.

# Django (both optional for local development; settings.py has local fallbacks)
# Generate a secret key with:
#   .venv/Scripts/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True

# PostgreSQL (see docs/database/README.md)
DB_NAME=basera
DB_USER=basera_app
# The password you typed when docs/database/setup_postgres.sql asked for it.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (optional). Fill both to send real emails through Gmail; leave them
# empty to print emails in the runserver console instead.
# EMAIL_APP_PASSWORD is a Gmail "app password" (16 characters), not the
# Gmail account password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
